{
  "name": "HTT",
  "scopeName": "source.htt",
  "patterns": [
    {
      "include": "#lua-code-block"
    },
    {
      "include": "#component-begin"
    },
    {
      "include": "#component-end"
    },
    {
      "include": "#lua-line"
    },
    {
      "include": "#lua-expression"
    },
    {
      "include": "#render-call"
    },
    {
      "include": "#line-continuation"
    }
  ],
  "repository": {
    "lua-code-block": {
      "begin": "^(\\s*%%%)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.htt"
        }
      },
      "end": "^(\\s*%%%)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.htt"
        }
      },
      "name": "meta.embedded.block.lua",
      "patterns": [
        {
          "include": "source.lua"
        }
      ]
    },
    "component-begin": {
      "match": "^(\\s*%\\s*)(<)(\\w+)(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.htt"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.htt"
        },
        "3": {
          "name": "entity.name.class.htt"
        },
        "4": {
          "name": "punctuation.definition.tag.end.htt"
        }
      }
    },
    "component-end": {
      "match": "^(\\s*%\\s*)(<\\/)(\\w+)(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.htt"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.htt"
        },
        "3": {
          "name": "entity.name.class.htt"
        },
        "4": {
          "name": "punctuation.definition.tag.end.htt"
        }
      }
    },
    "lua-line": {
      "begin": "^\\s*%((?!@))",
      "end": "$",
      "name": "meta.embedded.lua",
      "patterns": [
        {
          "include": "source.lua"
        }
      ]
    },
    "lua-expression": {
      "begin": "({{)(?!@)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.htt"
        }
      },
      "end": "(}})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.end.htt"
        }
      },
      "name": "meta.embedded.line.lua",
      "patterns": [
        {
          "include": "source.lua"
        }
      ]
    },
    "render-call": {
      "begin": "({{)(@)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.htt"
        },
        "2": {
          "name": "keyword.control.htt"
        }
      },
      "end": "(}})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.end.htt"
        }
      },
      "name": "meta.function-call.htt",
      "patterns": [
        {
          "match": "\\s+(\\w+)",
          "name": "entity.name.function.htt"
        },
        {
          "include": "source.lua"
        }
      ]
    },
    "line-continuation": {
      "match": "^(\\s*)(~>)",
      "captures": {
        "2": {
          "name": "comment.line.continuation.htt"
        }
      }
    }
  }
}
